# Smart Kitchen Pal — Backend Environment Configuration Example
# Copy this file to backend/.env and add your keys

# Google Gemini API Key (required for vision detection)
GEMINI_API_KEY=your_gemini_api_key_here

# USDA FoodData Central (optional, for live nutritional database)
USDA_API_KEY=DEMO_KEY

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Feature Flags
ENABLE_BLIP=true
ENABLE_YOLO=true
ENABLE_WHISPER=true
ENABLE_DIFFUSION=false
ENABLE_RAG=true
ENABLE_USDA=true
ENABLE_WASTE_TRACKER=true
